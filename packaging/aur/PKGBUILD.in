# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/funkitty
# for each release; edit the template there, not this file.

pkgname=funkitty-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fun time with Pink Kitty: little reading and typing games for young children, in the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/funkitty"
license=('MIT')
provides=('funkitty')
conflicts=('funkitty')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("funkitty-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/funkitty/v$pkgver/LICENSE")
source_x86_64=("funkitty-$pkgver-x86_64::$url/releases/download/v$pkgver/funkitty-x86_64-unknown-linux-musl")
source_aarch64=("funkitty-$pkgver-aarch64::$url/releases/download/v$pkgver/funkitty-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/funkitty-$pkgver-$CARCH" "$pkgdir/usr/bin/funkitty"
    install -Dm644 "$srcdir/funkitty-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # pacman owns this copy: the marker tells the game never to update itself. It looks
    # for it at ../share/funkitty/managed-by from the directory of its binary.
    install -d "$pkgdir/usr/share/funkitty"
    echo "pacman; update the funkitty-bin package" > "$pkgdir/usr/share/funkitty/managed-by"
}
